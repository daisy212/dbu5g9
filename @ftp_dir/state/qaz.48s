'UnitsBench' STO

«
	@ Helper program to draw a line at index i
	«
		10 6
		→ i XSize YSize
		«
			@ Build starting point
			{ }
			@ X coordinate
			i sin XSize × +
			@ Y coordinate
			i 2.17 × cos YSize
			× +
			@ Build end point
			{ }
			@ X coordinate
			i 2.30 × sin XSize
			× +
			@ Y coordinate
			i 2.61500 × cos YSize
			× +
			@ Draw the line and wait for 1ms
			DrawLine
		»
	»
	→ MyLine
	«
		«
			Degrees ClearLCD 0
			360000
			for i
				@ Erase old line
				1 10
				for g
					g 10 ÷ GrayPattern
					Foreground i 100
					g + - MyLine
				next
				@ Set random foreground and draw new line
				if
					Ticks 1000 ÷ 10
					mod 7 <
				then
					16#0 Foreground
				else
					16#1111111111111111
					i 16 mod × Foreground
				end i MyLine
				@ Wait 1ms
				1.00E-3 Wait
			next
		»
	»
	TimedEval
»
'Lines' STO

«
	«
		@ User RPL program lifted straight from
		@ https://www.hpmuseum.org/cgi-sys/cgiwrap/hpmuseum/articles.cgi?read=700
		0
		do
			8 Swap 1 +
			while
				Duplicate2
				do
					1 -
				until
					Duplicate2 5 + Pick
					- abs Duplicate2
					- × not
				end
			repeat
				Drop
				while
					Swap Duplicate 1
					same
				repeat
					-
				end
				1 - Swap
			end
			Drop
		until
			Duplicate 8 same
		end
		→List
	»
	@ Compute execution duration of that code
	TimedEval
»
'Nqueens' STO

«
	«
		@ Helper program to generate the coordinates
		«
			→ i
			«
				16#1111111111111111
				i 16 mod × Foreground
				{ } i 2.51 × sin
				9.50 × + i 3.21 ×
				cos 4.50 × 2.00 +
				+
				{ } i 1.03 × sin
				9.50 × + i 5.17 ×
				cos 4.50 × 2.00 +
				+
			»
		»
		→ Coords
		«
			ClearLCD 16#0 Foreground
			" Rectangles "
			{ 16#C8 16#B4 3 True
				True 0 1 } DrawText
			0 LineWidth 0 300
			for i
				i Coords DrawRectangle
				1.00E-2 Wait
			next
			ClearLCD 16#0 Foreground
			" Outlines "
			{ 16#C8 16#B4 3 True
				True 0 1 } DrawText
			0 LineWidth 0 300
			for i
				i 7 mod 1 + LineWidth
				i Coords DrawRectangle
				1.00E-2 Wait
			next
			ClearLCD 16#0 Foreground
			" Ellipse "
			{ 16#C8 16#B4 3 True
				True 0 1 } DrawText
			0 LineWidth 0 300
			for i
				i Coords DrawEllipse
				1.00E-2 Wait
			next
			ClearLCD 16#0 Foreground
			" Outlines "
			{ 16#C8 16#B4 3 True
				True 0 1 } DrawText
			0 LineWidth 0 300
			for i
				i 7 mod 1 + LineWidth
				i Coords DrawEllipse
				1.00E-2 Wait
			next
			ClearLCD 16#0 Foreground
			" Rounded Rect "
			{ 16#C8 16#B4 3 True
				True 0 1 } DrawText
			0 LineWidth 0 300
			for i
				i Coords 16#0 i 75
				mod + DrawRoundedRectangle
				1.00E-2 Wait
			next
			ClearLCD 16#0 Foreground
			" Outlines "
			{ 16#C8 16#B4 3 True
				True 0 1 } DrawText
			0 LineWidth 0 300
			for i
				i 7 mod 1 + LineWidth
				i Coords 16#0 i 75
				mod + DrawRoundedRectangle
				1.00E-2 Wait
			next
			ClearLCD 16#0 Foreground
			" Clipping "
			{ 16#C8 16#B4 3 True
				True 0 1 } DrawText
			0 LineWidth
			{ 30 30 370 150 } Clip
			0 300
			for i
				i Coords 16#0 i 75
				mod + DrawRoundedRectangle
				1.00E-2 Wait
			next
			{ } Clip
		»
	»
	@ Compute execution duration of that code
	TimedEval
»
'LcdShapes' STO

«
	@ Restore foreground and background in case we interrupted another program
	0 GrayPattern Foreground
	64 WordSize 1 GrayPattern
	Background 0 300
	for i
		"Text line i=" i + " "
		+ i 9 mod DrawText 1.00E-2
		Wait
	next
	0 300
	for i
		"Fractional line i="
		i + " " + i 16 ÷ 9
		mod DrawText 1.00E-2
		Wait
	next
	«
		Duplicate2 DrawText
		1.00E-3 Wait 'Foreground'
		Recall
		→ fg
		«
			1 GrayPattern Foreground
			DrawText fg Foreground
		»
	»
	→ DispThenErase
	«
		ClearLCD 0 300
		for i
			" Pixel positioning "
			{ 16#C8 16#78 2 True
				True 0 0 } DrawText
			"Pos "
			{ } 16#0 i + 223 mod
			+ 16#0 i 45 mod + 25
			+ + Duplicate Rot Swap
			→Text + " " + Swap
			DispThenErase
		next
		ClearLCD Degrees 1 360
		for i
			" Complex positioning "
			{ 16#C8 16#78 2 True
				True 0 0 } DrawText
			" Angle " i + 4.50
			i ℝ→Polarℂ 2.90
			- DispThenErase
		next
		ClearLCD 1 360
		for i
			" Scaled positioning "
			{ 16#C8 16#78 2 True
				True 0 0 } DrawText
			" Angle " i +
			{ } i cos 7 × 2.90
			- + i 3 × sin 3 ×
			+ DispThenErase
		next
	»
	ClearLCD " Fonts "
	{ 16#C8 16#B4 2 True
		True 0 1 } DrawText
	0 11
	for f
		"Font " f +
		{
			{ 16#A 16#0 }
			{ 16#A 16#30 }
			{ 16#A 16#50 }
			{ 16#A 16#62 }
			{ 16#A 16#82 }
			{ 16#F0 16#0 }
			{ 16#F0 16#19 }
			{ 16#F0 16#2D }
			{ 16#F0 16#40 }
			{ 16#F0 16#54 }
			{ 16#F0 16#78 }
			{ 16#F0 16#96 }
		}
		f 1 + Get f + DrawText
	next
	1.50 Wait ClearLCD " Patterns "
	{ 16#C8 16#B4 2 True
		True 0 1 } DrawText
	0 15
	for p
		16#1111111111111111
		p × Foreground 0 11
		for f
			"Font " f +
			{
				{ 16#A 16#0 }
				{ 16#A 16#30 }
				{ 16#A 16#50 }
				{ 16#A 16#62 }
				{ 16#A 16#82 }
				{ 16#F0 16#0 }
				{ 16#F0 16#19 }
				{ 16#F0 16#2D }
				{ 16#F0 16#40 }
				{ 16#F0 16#54 }
				{ 16#F0 16#78 }
				{ 16#F0 16#96 }
			}
			f 1 + Get f + DrawText
		next
		0.200 Wait
	next
	ClearLCD 16#0 Foreground
	" Background "
	{ 16#C8 16#B4 2 True
		True 0 1 } DrawText
	16#FFFFFFFFFFFFFFFF Foreground
	0 15
	for p
		16#1111111111111111
		p × Background 0 11
		for f
			"Font " f +
			{
				{ 16#A 16#0 }
				{ 16#A 16#30 }
				{ 16#A 16#50 }
				{ 16#A 16#62 }
				{ 16#A 16#82 }
				{ 16#F0 16#0 }
				{ 16#F0 16#19 }
				{ 16#F0 16#2D }
				{ 16#F0 16#40 }
				{ 16#F0 16#54 }
				{ 16#F0 16#78 }
				{ 16#F0 16#96 }
			}
			f 1 + Get f + DrawText
		next
		0.200 Wait
	next
	ClearLCD 0 GrayPattern
	Foreground 1 GrayPattern
	Background " Align left "
	{ 16#0 16#78 2 True True
		1 0 } DrawText " Align Right "
	{ 16#190 16#78 2 True
		True -1 0 } DrawText
	" Center "
	{ 16#C8 16#78 2 True
		True 0 0 } DrawText
	" Align Top "
	{ 16#C8 16#0 2 True True
		0 1 } DrawText " Align Bottom "
	{ 16#C8 16#F0 2 True
		True 0 -1 } DrawText
