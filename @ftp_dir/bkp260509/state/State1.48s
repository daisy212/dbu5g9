			KineticEnergy
				«
					@ Select drawing range
					-0.200 1.20 PlotXRange
					-0.220 1.80 PlotYRange
					@ Draw the C limit on the right
					5 LineWidth 0.700
					0.700 0.900 RGBPattern
					Foreground 1-ⅈ5
					1+ⅈ5 DrawLine
					@ Draw axes
					0 0 0 RGBPattern
					Foreground 1 LineWidth
					DrawAxes
					@ Draw the classical case (red)
					0.700 0 0 RGBPattern
					Foreground 3 LineWidth
					'1/2·(Max(x;0))²'
					FunctionPlot "Classical"
					{ 0.700 0.200 0 }
					DrawText
					@ Draw the relativistic case (green)
					2 LineWidth 0 0.700
					0 RGBPattern Foreground
					'1÷√(1-(Min(Max(x;0);0.999))²)-1'
					FunctionPlot "Relativistic"
					{ 0.550 1.00 0 }
					DrawText
					@ Axes labels
					0 0 0.500 RGBPattern
					Foreground "Kinetic Energy"
					{ -0.150 1.35 0 }
					DrawText "Speed"
					{ 1.03 -3.00E-2 0
					} DrawText "c"
					{ 0.950 -2.50E-2
						1 } DrawText "0.1·c ↑"
					{ 9.50E-2 -2.50E-2
						1 } DrawText 1 LineWidth
					16#0 Foreground
				»
		}
	Math
		Directory {
			CntPt
				«
					«
						CountPrimes
					»
					TimedEval
				»
			Collatz
				«
					Duplicate "	  " +
					1 DrawText
					if
						USBPowered
					then
						AvailableMemory
						2 DrawText
					end
					if
						Duplicate 1 ≠
					then
						if
							Duplicate 2 mod
						then
							3 × 1 +
						else
							2 ÷
						end Collatz
					end
				»
			CollatzBenchmark
				«
					«
						989345275647 Collatz
					»
					TimedEval
				»
			CountPrimes
				«
					if
						Depth 1 <
					then
						1000
					end
					«
						3 Over Duplicate
						2 ≤ Swap 2 mod
						or
						→ n d r
						«
							while
								r d x² n ≤
								and
							repeat
								n d mod 'r' Store
								d 2 + 'd' Store
							end
							r not not
						»
					»
					1
					→ MaxNumber CheckIfPrime
					Count
					«
						3 MaxNumber
						for i
							if
								i CheckIfPrime
							then
								'Count' Increment
								Drop
							end
							2
						step
						Count
					»
				»
			EquationSolving
				«
					{ 'AA²+BB²=CC²'
						'sin α÷a=sin β÷b'
						'sin β÷b=sin γ÷c'
						'sin α÷b=sin γ÷c'
						'α+β+γ=180' 's=(a+b+c)÷2'
						'A=√(s·(s-a)·(s-b)·(s-c))'
						'c²=a²+b²-2·a·b·cos
						γ' 'b²=a²+c²-2·a·c·cos
						β' 'a²=b²+c²-2·b·c·cos
						α' } StoreEquation
					10_m 'AA' Store 85_ft
					'BB' Store 1_cm 'CC'
					Store SolvingMenu
				»
			MultiSolver
				«
					[ 'sin X=0.5·cos
						Y' 'sin X=0.3·cos
						X' ]
					[ 'X' 'Y' ]
					[ 1 1 ] SolverMenu
					Root
				»
