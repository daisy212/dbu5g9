	RPL
		Directory {
			PathHeader
				«
					«
						Time " " DirectoryPath
						Tail →Text + +
						"
" + Date + " Mem: " +
						AvailableMemory
						+
					»
					Header 10000 CustomHeaderRefresh
				»
			BatteryLevelHeader
				«
					10000 CustomHeaderRefresh
					«
						BatteryVoltage " "
						+ LowBattery +
					»
					Header
				»
			RuntimeStatsHeader
				«
					10000 CustomHeaderRefresh
					«
						RuntimeStatistics
						Arry→
						→ running sleeping
						runs dims
						«
							"" runs + ":" +
							running UnitValue
							+ "/" + sleeping
							UnitValue +
						»
					»
					Header
				»
			BatteryStatsHeader
				«
					10000 CustomHeaderRefresh
					@ We want statistics to persist even in case of low-bat crash
					"BATTERY.CSV" 'ΣData'
					Store
					«
						Time UnitValue →Decimal
						BatteryVoltage Duplicate2
						2 →Arry Σ+ ΣSize
						" " + Swap + " "
						+ Swap 5 Round +
						" " + LowBattery
						+
					»
					Header
				»
			Anagram
				Directory {
					PRANAG
						«
							if
								B 0 >
							then
								-1 'B' Store+
								PRDEPTH Duplicate
								B -
								for X
									X Roll PRANAG
									X RollDown -1
								step
								1 'B' Store+
							else
								PRDEPTH DuplicateN
								PRDEPTH 2 ÷ 1
								- 1
								start
									+ -1
								step
								4 DrawText
							end
						»
					PRDEPTH
						«
							Depth C -
						»
					ANAG
						«
							→ A
							«
								ClearLCD A Size
								'B' Store Depth
								'C' Store 1 B
								for X
									A X Duplicate
									Extract
								next
								PRANAG PRDEPTH
								DropN
								{ B C } Purge
							»
						»
				}
			IfTETest
				«
					Duplicate 1 =
					«
						Drop "One"
					»
					«
						1 < "Less" "More"
						IfThenElse
					»
					IfThenElse '1=1'
					'1+1' '1·3' IfThenElse
				»
			IfThenElseEval
				«
					→ x
					«
						if
							'x<1'
						then
							"less"
						else
							"more"
						end
					»
				»
			CaseTest
				«
					case
						Duplicate "A" ==
						then
							"Alpha"
						end
						Duplicate "B" ==
						then
							"Beta"
						end
						Duplicate "C" ==
						then
							"Gamma"
						end
						"D"
						when
							"Delta"
						end
					end
				»
			Recurse
				«
					1 + Duplicate 1 DrawText
					AvailableMemory 2
					DrawText Recurse
				»
			Prompting
				«
					"Enter value then hit Run key"
					Prompt 1 + "Next value"
					→Tag
				»
			Inputting
				«
					"Enter value then hit Run key"
					"What?" Input 1 +
					"Next value" →Tag
				»
			CustomMenu
				[[ D E F ]
				  [ G H I ]]
		}
	Perf
		Directory {
			SumTestWithLoop
				«
					@ Summation loop
					@ See https://www.hpmuseum.org/forum/thread-9750.html
					Radians
					«
						0 1 1000
						for x
							x tan⁻¹ sin
							exp ∛ +
						next
					»
					TimedEval
				»
			SumTestWithFunction
				«
					@ Summation loop
					@ See https://www.hpmuseum.org/forum/thread-9750.html
					Radians
					«
						x 1 1000 '∛ (exp
						(sin (tan⁻¹ x)))'
						Σ
					»
					TimedEval
				»
			NQueens
				«
					«
						@ User RPL program lifted straight from
						@ https://www.hpmuseum.org/cgi-sys/cgiwrap/hpmuseum/articles.cgi?read=700
						0
						do
							8 Swap 1 +
							while
								Duplicate2
								do
